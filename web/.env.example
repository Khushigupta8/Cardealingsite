# Supabase: Project Settings -> API Keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server-only secret. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Where invitation and reset emails send people. On Vercel, leave unset to use the production URL.
APP_URL=http://localhost:3000

PHOTO_BUCKET=vehicle-photos

# Stripe memberships (test keys start sk_test_). Webhook secret from the Stripe webhook endpoint.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-secret

# Optional: app emails through Resend. Without the key, emails are skipped.
RESEND_API_KEY=re_your-key
EMAIL_FROM=Dealer Review <reviews@your-domain.com>
